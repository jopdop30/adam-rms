From 1de875722b8c9ceaa78ff6b38a2783276cee23ca Mon Sep 17 00:00:00 2001
From: jopdop30 <jopdop30@users.noreply.github.com>
Date: Sun, 8 Nov 2026 11:39:04 +0000
Subject: [PATCH 4/5] CI: e2e tests on PRs into nopayne; image build on
 nopayne-v* tags

e2e-tests.yml also runs on pull requests into nopayne. New
nopayne-image.yml builds the Dockerfile on nopayne-v* tags and pushes
ghcr.io/jopdop30/adam-rms:<tag> and :nopayne-latest (deploy by the
explicit tag; see NOPAYNE-FORK.md).

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
 .github/workflows/e2e-tests.yml     |  1 +
 .github/workflows/nopayne-image.yml | 63 +++++++++++++++++++++++++++++
 2 files changed, 64 insertions(+)
 create mode 100644 .github/workflows/nopayne-image.yml

diff --git a/.github/workflows/e2e-tests.yml b/.github/workflows/e2e-tests.yml
index 64950269..02a3824e 100644
--- a/.github/workflows/e2e-tests.yml
+++ b/.github/workflows/e2e-tests.yml
@@ -4,6 +4,7 @@ on:
   pull_request:
     branches:
       - main
+      - nopayne # No Payne fork: run the suite on PRs into the fork's release branch too
 
 permissions:
   contents: read
diff --git a/.github/workflows/nopayne-image.yml b/.github/workflows/nopayne-image.yml
new file mode 100644
index 00000000..5a0defe1
--- /dev/null
+++ b/.github/workflows/nopayne-image.yml
@@ -0,0 +1,63 @@
+# No Payne fork (see NOPAYNE-FORK.md): builds the Docker image production runs.
+# Push a tag like nopayne-v1.205.6-1 on the nopayne branch to publish
+#   ghcr.io/jopdop30/adam-rms:<tag>  and  ghcr.io/jopdop30/adam-rms:nopayne-latest
+# Deploy by the explicit <tag>, never by nopayne-latest.
+name: No Payne image
+
+on:
+  push:
+    tags:
+      - "nopayne-v*"
+
+permissions:
+  contents: read
+  packages: write
+
+concurrency:
+  group: ${{ github.workflow }}-${{ github.ref }}
+  cancel-in-progress: false
+
+env:
+  REGISTRY_IMAGE: ghcr.io/jopdop30/adam-rms
+
+jobs:
+  build:
+    runs-on: ubuntu-latest
+    steps:
+      - name: Check out code
+        uses: actions/checkout@v4
+
+      - name: Write version number
+        run: |
+          mkdir -p src/version
+          echo "$TAG" > src/version/TAG.txt
+        env:
+          TAG: ${{ github.ref_name }}
+
+      - name: Set up Docker buildx
+        uses: docker/setup-buildx-action@v3
+
+      - name: Log in to GitHub Container Registry
+        uses: docker/login-action@v3
+        with:
+          registry: ghcr.io
+          username: ${{ github.actor }}
+          password: ${{ secrets.GITHUB_TOKEN }}
+
+      - name: Build and push
+        uses: docker/build-push-action@v6
+        with:
+          context: .
+          file: ./Dockerfile
+          platforms: linux/amd64
+          push: true
+          tags: |
+            ${{ env.REGISTRY_IMAGE }}:${{ github.ref_name }}
+            ${{ env.REGISTRY_IMAGE }}:nopayne-latest
+          labels: |
+            org.opencontainers.image.source=https://github.com/jopdop30/adam-rms
+            org.opencontainers.image.revision=${{ github.sha }}
+            org.opencontainers.image.version=${{ github.ref_name }}
+            org.opencontainers.image.licenses=AGPL-3.0
+          cache-from: type=gha,scope=nopayne
+          cache-to: type=gha,mode=max,scope=nopayne
-- 
